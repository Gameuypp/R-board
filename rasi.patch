+/**
+ * Named sections for the clipboard. Stored in their own small preferences file, separate from
+ * FUTO's clipboard data, so they can never corrupt the clipboard history.
+ */
+object RasiSections {
+    val names = mutableStateListOf<String>()
+    private val assignments = mutableStateMapOf<String, String>()
+    private var prefs: SharedPreferences? = null
+    private const val SEP = "\u001F"
+
+    fun init(context: Context) {
+        if (prefs != null) return
+        val p = context.applicationContext.getSharedPreferences("rasi_clip_sections", Context.MODE_PRIVATE)
+        prefs = p
+        names.clear()
+        names.addAll((p.getString("names", "") ?: "").split(SEP).filter { it.isNotBlank() })
+        assignments.clear()
+        for ((k, v) in p.all) {
+            if (k.startsWith("item_") && v is String) {
+                assignments[k.removePrefix("item_")] = v
+            }
+        }
+    }
+
+    private fun save() {
+        prefs?.edit()?.putString("names", names.joinToString(SEP))?.apply()
+    }
+
+    fun keyOf(entry: ClipboardEntry): String =
+        entry.backingFile ?: ("t" + (entry.text ?: "").toFNV1aHash().toString())
+
+    fun sectionOf(entry: ClipboardEntry): String? = assignments[keyOf(entry)]
+
+    fun inSection(entry: ClipboardEntry, section: String): Boolean =
+        section.isEmpty() || assignments[keyOf(entry)] == section
+
+    fun assign(entry: ClipboardEntry, section: String?) {
+        val k = keyOf(entry)
+        if (section == null) {
+            assignments.remove(k)
+            prefs?.edit()?.remove("item_$k")?.apply()
+        } else {
+            assignments[k] = section
+            prefs?.edit()?.putString("item_$k", section)?.apply()
+        }
+    }
+
+    fun addSection(name: String) {
+        val n = name.trim()
+        if (n.isNotEmpty() && !names.contains(n)) {
+            names.add(n)
+            save()
+        }
+    }
+
+    fun removeSection(name: String) {
+        names.remove(name)
+        save()
+    }
+}
+
+@Composable
+private fun SectionChip(label: String, isSelected: Boolean, onClick: () -> Unit) {
+    if (isSelected) {
+        Button(onClick = onClick, contentPadding = PaddingValues(horizontal = 12.dp)) { Text(label) }
+    } else {
+        OutlinedButton(onClick = onClick, contentPadding = PaddingValues(horizontal = 12.dp)) { Text(label) }
+    }
+    Spacer(Modifier.width(6.dp))
+}
+
+/** Row of section tabs shown at the top of the clipboard. "All" shows everything. */
+@Composable
+fun RasiSectionsBar(selected: MutableState<String>, reorder: MutableState<Boolean>? = null) {
+    val context = LocalContext.current
+    RasiSections.init(context)
+    val adding = remember { mutableStateOf(false) }
+    val newName = remember { mutableStateOf("") }
+
+    Column(Modifier.fillMaxWidth()) {
+        Row(
+            Modifier
+                .fillMaxWidth()
+                .horizontalScroll(rememberScrollState())
+                .padding(horizontal = 4.dp, vertical = 2.dp),
+            verticalAlignment = Alignment.CenterVertically
+        ) {
+            SectionChip("All", selected.value.isEmpty()) { selected.value = "" }
+            RasiSections.names.forEach { n ->
+                SectionChip(n, selected.value == n) { selected.value = n }
+            }
+            OutlinedButton(
+                onClick = {
+                    adding.value = !adding.value
+                    newName.value = ""
+                },
+                contentPadding = PaddingValues(horizontal = 12.dp)
+            ) { Text(if (adding.value) "Cancel" else "+") }
+
+            if (reorder != null) {
+                Spacer(Modifier.width(6.dp))
+                OutlinedButton(
+                    onClick = { reorder.value = !reorder.value },
+                    contentPadding = PaddingValues(horizontal = 12.dp)
+                ) { Text(if (reorder.value) "Done" else "Reorder") }
+            }
+
+            if (selected.value.isNotEmpty()) {
+                TextButton(onClick = {
+                    RasiSections.removeSection(selected.value)
+                    selected.value = ""
+                }) { Text("Delete section") }
+            }
+        }
+
+        if (adding.value) {
+            Row(
+                Modifier
+                    .fillMaxWidth()
+                    .padding(4.dp),
+                verticalAlignment = Alignment.CenterVertically
+            ) {
+                Surface(
+                    color = LocalKeyboardScheme.current.surface,
+                    border = BorderStroke(1.dp, SolidColor(LocalKeyboardScheme.current.outline)),
+                    shape = RoundedCornerShape(8.dp),
+                    modifier = Modifier
+                        .weight(1.0f)
+                        .height(48.dp),
+                ) {
+                    Box(Modifier.padding(8.dp), contentAlignment = Alignment.CenterStart) {
+                        ActionTextEditor(
+                            newName,
+                            multiline = false,
+                            autocorrect = false,
+                            placeholder = "Section name"
+                        )
+                    }
+                }
+                Spacer(Modifier.width(8.dp))
+                Button(
+                    onClick = {
+                        RasiSections.addSection(newName.value)
+                        adding.value = false
+                        newName.value = ""
+                    },
+                    enabled = newName.value.isNotBlank()
+                ) { Text("Add") }
+            }
+        }
+    }
+}
