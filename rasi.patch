+import java.io.File
+import java.util.UUID
+
+/** Your own stickers and GIFs, saved inside the keyboard's private storage. */
+object RasiMedia {
+    fun dir(context: Context, kind: String): File {
+        val d = File(context.filesDir, "rasi_media/$kind")
+        d.mkdirs()
+        return d
+    }
+
+    fun list(context: Context, kind: String): List<File> {
+        val files = dir(context, kind).listFiles()?.toList() ?: emptyList()
+        return files.sortedByDescending { it.lastModified() }
+    }
+
+    fun mimeOf(file: File): String = when (file.extension.lowercase()) {
+        "gif" -> "image/gif"
+        "png" -> "image/png"
+        "webp" -> "image/webp"
+        "jpg", "jpeg" -> "image/jpeg"
+        "mp4", "m4v" -> "video/mp4"
+        "webm" -> "video/webm"
+        "3gp" -> "video/3gpp"
+        "mkv" -> "video/x-matroska"
+        "mov" -> "video/quicktime"
+        else -> "image/*"
+    }
+
+    fun isVideo(file: File): Boolean = mimeOf(file).startsWith("video/")
+
+    fun importFile(context: Context, kind: String, uri: Uri) {
+        try {
+            val mime = context.contentResolver.getType(uri) ?: "image/png"
+            val ext = MimeTypeMap.getSingleton().getExtensionFromMimeType(mime) ?: "png"
+            val out = File(dir(context, kind), UUID.randomUUID().toString() + "." + ext)
+            context.contentResolver.openInputStream(uri)?.use { input ->
+                out.outputStream().use { output -> input.copyTo(output) }
+            }
+        } catch (e: Exception) {
+            // Ignore files that can't be read
+        }
+    }
+}
+
+@Composable
+private fun MediaThumb(file: File, onSend: () -> Unit, onDelete: () -> Unit) {
+    val isVideo = RasiMedia.isVideo(file)
+    val bitmap = remember(file.name) {
+        try {
+            if (isVideo) {
+                val retriever = MediaMetadataRetriever()
+                try {
+                    retriever.setDataSource(file.absolutePath)
+                    retriever.getFrameAtTime(0)?.asImageBitmap()
+                } finally {
+                    retriever.release()
+                }
+            } else {
+                val opts = BitmapFactory.Options()
+                opts.inSampleSize = 4
+                BitmapFactory.decodeFile(file.absolutePath, opts)?.asImageBitmap()
+            }
+        } catch (e: Exception) {
+            null
+        }
+    }
+
+    Box(
+        modifier = Modifier
+            .size(88.dp)
+            .clip(RoundedCornerShape(8.dp))
+            .pointerInput(file.name) {
+                detectTapGestures(onTap = { onSend() }, onLongPress = { onDelete() })
+            },
+        contentAlignment = Alignment.Center
+    ) {
+        if (bitmap != null) {
+            Image(
+                bitmap = bitmap,
+                contentDescription = null,
+                contentScale = ContentScale.Fit,
+                modifier = Modifier.fillMaxSize()
+            )
+        } else {
+            Text(if (isVideo) "VIDEO" else "?")
+        }
+        if (isVideo) {
+            Text("\u25B6", modifier = Modifier.align(Alignment.BottomStart).padding(4.dp))
+        }
+    }
+}
+
+private fun mediaAction(kind: String, nameRes: Int, iconRes: Int, emptyHint: String) = Action(
+    icon = iconRes,
+    name = nameRes,
+    simplePressImpl = null,
+    windowImpl = { manager, _ ->
+        val files = mutableStateListOf<File>()
+
+        object : ActionWindow() {
+            override val showCloseButton: Boolean
+                get() = true
+
+            override val positionIsUserManagable: Boolean
+                get() = false
+
+            override val fixedWindowHeight: androidx.compose.ui.unit.Dp?
+                get() = rasiTallPanelHeight(manager.getContext())
+
+            @Composable
+            override fun windowName(): String = stringResource(nameRes)
+
+            @Composable
+            override fun WindowContents(keyboardShown: Boolean) {
+                val context = LocalContext.current
+
+                // Re-check the folder every second so new uploads show up on their own.
+                LaunchedEffect(Unit) {
+                    while (true) {
+                        val latest = RasiMedia.list(context, kind)
+                        if (latest != files.toList()) {
+                            files.clear()
+                            files.addAll(latest)
+                        }
+                        delay(1000)
+                    }
+                }
+
+                Column(Modifier.fillMaxSize()) {
+                Column(Modifier.weight(1.0f).fillMaxWidth().padding(8.dp)) {
+                    Button(
+                        onClick = {
+                            val i = Intent(context, RasiPickerActivity::class.java)
+                            i.putExtra("kind", kind)
+                            i.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
+                            context.startActivity(i)
+                        },
+                        modifier = Modifier.fillMaxWidth()
+                    ) { Text("+ Add pictures or videos") }
+
+                    Spacer(Modifier.height(8.dp))
+
+                    if (files.isEmpty()) {
+                        Text(emptyHint)
+                    } else {
+                        LazyVerticalGrid(
+                            columns = GridCells.Adaptive(88.dp),
+                            modifier = Modifier.weight(1.0f).fillMaxWidth(),
+                            horizontalArrangement = Arrangement.spacedBy(6.dp),
+                            verticalArrangement = Arrangement.spacedBy(6.dp)
+                        ) {
+                            items(files.toList(), key = { it.name }) { file ->
+                                MediaThumb(
+                                    file,
+                                    onSend = {
+                                        val mime = RasiMedia.mimeOf(file)
+                                        val id = ClipboardProviderState.addRequest(
+                                            ClipboardPasteRequest(
+                                                file = file,
+                                                mimeType = mime,
+                                                expiration = System.currentTimeMillis() + 5L * 60L * 1000L
+                                            )
+                                        )
+                                        val uri = Uri.parse("content://${CLIPBOARD_AUTHORITY}/clip/$id")
+                                        manager.typeUri(uri, listOf(mime), true)
+                                    },
+                                    onDelete = {
+                                        manager.requestDialog(
+                                            "Delete this from your collection?",
+                                            listOf(
+                                                DialogRequestItem("Cancel") { },
+                                                DialogRequestItem("Delete") { file.delete() }
+                                            )
+                                        ) { }
+                                    }
+                                )
+                            }
+                        }
+                    }
+                }
+                if (!keyboardShown) {
+                    RasiEmojiBottomBar(
+                        selected = 2,
+                        onExit = { manager.closeActionWindow() },
+                        onBackspace = { manager.backspace(1) }
+                    )
+                }
+                }
+            }
+
+            override fun close(): CloseResult = CloseResult.Default
+        }
+    },
+)
+
+val RasiStickersAction = mediaAction(
+    "stickers", R.string.rasi_stickers, R.drawable.rasi_sticker,
+    "No stickers yet. Tap the button above to add pictures or videos from your phone. Tap a sticker to send it, hold it to delete."
+)
