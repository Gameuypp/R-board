+private class RasiLang(val name: String, val code: String?)
+
+// Rasi is last on purpose (the secret option). code == null means Rasi.
+// Every language the ML Kit translation library supports, English first, A-Z after that.
+private val RASI_LANGS: List<RasiLang> = run {
+    val others = TranslateLanguage.getAllLanguages()
+        .filter { it != TranslateLanguage.ENGLISH }
+        .map { code ->
+            val name = Locale.forLanguageTag(code).getDisplayLanguage(Locale.ENGLISH)
+            RasiLang(if (name.isBlank()) code else name, code)
+        }
+        .sortedBy { it.name }
+    listOf(RasiLang("English", TranslateLanguage.ENGLISH)) + others + RasiLang("Rasi", null)
+}
+
+private fun mlKitTranslate(
+    text: String, from: String, to: String,
+    onDone: (String) -> Unit, onError: (String) -> Unit
+) {
+    val options = TranslatorOptions.Builder()
+        .setSourceLanguage(from)
+        .setTargetLanguage(to)
+        .build()
+    val translator = Translation.getClient(options)
+    translator.downloadModelIfNeeded(DownloadConditions.Builder().build())
+        .addOnSuccessListener {
+            translator.translate(text)
+                .addOnSuccessListener { onDone(it) }
+                .addOnFailureListener { e -> onError("Translation failed: " + e.message) }
+        }
+        .addOnFailureListener { e -> onError("Language download failed: " + e.message) }
+}
+
+private fun translateAny(
+    text: String, from: RasiLang, to: RasiLang,
+    onDone: (String) -> Unit, onError: (String) -> Unit
+) {
+    if (text.isBlank()) { onDone(""); return }
+    // Step 1: get plain text in the "from" language (Rasi is decoded with the swap table)
+    val srcText = if (from.code == null) RasiMap.translate(text) else text
+    val srcCode = from.code ?: TranslateLanguage.ENGLISH
+    val toCode = to.code
+    if (toCode == null) {
+        // Step 2 (to Rasi): go through English, then swap to Rasi
+        if (srcCode == TranslateLanguage.ENGLISH) onDone(RasiMap.translate(srcText))
+        else mlKitTranslate(srcText, srcCode, TranslateLanguage.ENGLISH,
+            { onDone(RasiMap.translate(it)) }, onError)
+    } else if (srcCode == toCode) {
+        onDone(srcText)
+    } else {
+        mlKitTranslate(srcText, srcCode, toCode, onDone, onError)
+    }
+}
+
+/**
+ * Translate panel like Gboard's. Pick the languages (Rasi is last), type in the box inside
+ * the panel, and the translation shows up live in the real text field while the panel keeps
+ * your original text so you can see both.
+ */
+val RasiAction = Action(
+    icon = R.drawable.rasi_translate,
+    name = R.string.rasi_mode,
+    simplePressImpl = null,
+    windowImpl = { manager, _ ->
+        val input = mutableStateOf("")
+        val output = mutableStateOf("")
+        val status = mutableStateOf("")
+        val from = mutableStateOf(RASI_LANGS.first())
+        val to = mutableStateOf(RASI_LANGS.last())
+        val picking = mutableStateOf(0) // 0 = none, 1 = picking "from", 2 = picking "to"
+        var seq = 0
+
+        fun baseConnection() = manager.getLatinIMEForDebug().getBaseInputConnection()
+
+        object : ActionWindow() {
+            override val showCloseButton: Boolean
+                get() = true
+
+            override val positionIsUserManagable: Boolean
+                get() = false
+
+            @Composable
+            override fun windowName(): String = stringResource(R.string.rasi_mode)
+
+            @Composable
+            override fun WindowContents(keyboardShown: Boolean) {
+                LaunchedEffect(Unit) { manager.forceActionWindowAboveKeyboard(true) }
+
+                LaunchedEffect(input.value, from.value, to.value) {
+                    delay(250)
+                    seq += 1
+                    val id = seq
+                    translateAny(input.value, from.value, to.value, { result ->
+                        if (id == seq) {
+                            output.value = result
+                            status.value = ""
+                            baseConnection()?.setComposingText(result, 1)
+                        }
+                    }, { error ->
+                        if (id == seq) status.value = error
+                    })
+                }
+
+                Column(Modifier.padding(8.dp, 0.dp)) {
+                    if (picking.value != 0) {
+                        Column(Modifier.verticalScroll(rememberScrollState())) {
+                            Text(if (picking.value == 1) "Translate from" else "Translate to")
+                            Spacer(Modifier.height(4.dp))
+                            RASI_LANGS.forEach { lang ->
+                                OutlinedButton(
+                                    onClick = {
+                                        if (picking.value == 1) from.value = lang else to.value = lang
+                                        picking.value = 0
+                                    },
+                                    modifier = Modifier.fillMaxWidth()
+                                ) { Text(lang.name) }
+                            }
+                        }
+                    } else {
+                        Row(
+                            Modifier.fillMaxWidth(),
+                            horizontalArrangement = Arrangement.Center,
+                            verticalAlignment = Alignment.CenterVertically
+                        ) {
+                            OutlinedButton(onClick = { picking.value = 1 }) { Text(from.value.name) }
+                            IconButton(onClick = {
+                                val t = from.value
+                                from.value = to.value
+                                to.value = t
+                            }) {
+                                Icon(painterResource(R.drawable.arrow_right), contentDescription = "Swap")
+                            }
+                            OutlinedButton(onClick = { picking.value = 2 }) { Text(to.value.name) }
+                        }
+
+                        Spacer(Modifier.height(8.dp))
+
+                        Row(verticalAlignment = Alignment.Bottom) {
+                            Surface(
+                                color = LocalKeyboardScheme.current.surface,
+                                border = BorderStroke(1.dp, SolidColor(LocalKeyboardScheme.current.outline)),
+                                shape = RoundedCornerShape(8.dp),
+                                modifier = Modifier.weight(1.0f).height(56.dp),
+                            ) {
+                                Box(contentAlignment = Alignment.CenterStart, modifier = Modifier.padding(8.dp)) {
+                                    ActionTextEditor(
+                                        input,
+                                        multiline = true,
+                                        autocorrect = false,
+                                        placeholder = "Type here to translate"
+                                    )
+                                }
+                            }
+
+                            Spacer(Modifier.width(8.dp))
+
+                            Button(
+                                onClick = {
+                                    baseConnection()?.finishComposingText()
+                                    input.value = ""
+                                    output.value = ""
+                                },
+                                enabled = input.value.isNotEmpty(),
+                                shape = RoundedCornerShape(16.dp),
+                                contentPadding = PaddingValues(0.dp),
+                                modifier = Modifier.size(48.dp)
+                            ) {
+                                Icon(painterResource(R.drawable.check), contentDescription = "Done")
+                            }
+                        }
+
+                        Spacer(Modifier.height(6.dp))
+                        Text(
+                            if (status.value.isNotEmpty()) status.value
+                            else to.value.name + ": " + output.value
+                        )
+                    }
+                }
+            }
+
+            override fun close(): CloseResult {
+                baseConnection()?.finishComposingText()
+                manager.forceActionWindowAboveKeyboard(false)
+                return CloseResult.Default
+            }
+        }
+    },
+)
+
+/** Toolbar button that turns RASI key-swap on/off. While on, every key types its RASI partner. */
+val RasiKeysAction = Action(
