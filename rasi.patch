--- /dev/null
+++ b/java/src/org/futo/inputmethod/latin/rasi/RasiUndo.kt
@@ -0,0 +1,98 @@
+package org.futo.inputmethod.latin.rasi
+
+import android.os.SystemClock
+import androidx.compose.runtime.mutableStateOf
+
+/**
+ * Remembers text removed by hold-delete (or a cut / selection delete) so the suggestion bar can
+ * offer an "Undo" button that puts it back. Never touches the clipboard.
+ */
+object RasiUndo {
+    @JvmField val available = mutableStateOf(false)
+
+    private val buf = StringBuilder()
+    private var pos = -1
+    private var lastRecordAt = 0L
+    private var pendingCutAt = 0L
+    private var cutText: String? = null
+
+    @JvmField var performer: Runnable? = null
+
+    private const val SETTLE_MS = 700L
+
+    /** Text removed by backspace. Earlier-deleted text sits after later-deleted text. */
+    @JvmStatic
+    fun record(deleted: String, repeat: Boolean) {
+        if (deleted.isEmpty()) return
+        if (!repeat) {
+            buf.setLength(0)
+            available.value = false
+        }
+        buf.insert(0, deleted)
+        lastRecordAt = SystemClock.uptimeMillis()
+        pos = -1
+        // A single tap of one character does nothing; holding (or deleting a word/selection) does.
+        if (repeat || deleted.length > 1) available.value = true
+    }
+
+    @JvmStatic
+    fun noteCut(text: String?) {
+        if (text.isNullOrEmpty()) return
+        cutText = text
+        pendingCutAt = SystemClock.uptimeMillis()
+    }
+
+    @JvmStatic
+    fun onSelectionUpdate(oldStart: Int, oldEnd: Int, newStart: Int, newEnd: Int) {
+        val now = SystemClock.uptimeMillis()
+        val cut = cutText
+        if (cut != null) {
+            if (now - pendingCutAt > 1500L) {
+                cutText = null
+            } else if (oldStart != oldEnd && newStart == newEnd) {
+                buf.setLength(0)
+                buf.append(cut)
+                cutText = null
+                pos = newStart
+                lastRecordAt = now
+                available.value = true
+                return
+            }
+        }
+        if (!available.value) return
+        if (now - lastRecordAt < SETTLE_MS) {
+            if (newStart == newEnd) pos = newStart
+            return
+        }
+        if (pos == -1) {
+            if (newStart == newEnd) pos = newStart
+            return
+        }
+        if (newStart != pos || newEnd != pos) clear()
+    }
+
+    @JvmStatic
+    fun clear() {
+        available.value = false
+        buf.setLength(0)
+        pos = -1
+        cutText = null
+    }
+
+    /** Returns the text to put back (and clears), or null if there is nothing to restore. */
+    @JvmStatic
+    fun take(): String? {
+        if (!available.value || buf.isEmpty()) {
+            clear()
+            return null
+        }
+        val s = buf.toString()
+        clear()
+        return s
+    }
+
+    @JvmStatic
+    fun perform() {
+        performer?.run()
+    }
+}
