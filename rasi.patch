+private class GiphyItem(val id: String, val previewUrl: String, val gifUrl: String, val ratio: Float)
+
+private const val KLIPY_DEFAULT_KEY = "tYDMT1jzLdKlAqyFNtDok93YjoGzIRQxy7YN3LrT1IaXjdhczBWAW0oEbYcfUJwt"
+
+/** Your KLIPY API key. A built-in default is used unless you save a different one. */
+private object GiphyKey {
+    private fun prefs(context: Context) =
+        context.applicationContext.getSharedPreferences("rasi_klipy", Context.MODE_PRIVATE)
+
+    fun get(context: Context): String =
+        (prefs(context).getString("api_key", "") ?: "").ifBlank { KLIPY_DEFAULT_KEY }
+
+    fun set(context: Context, key: String) {
+        prefs(context).edit().putString("api_key", key.trim()).apply()
+    }
+
+    fun customerId(context: Context): String {
+        val p = prefs(context)
+        var id = p.getString("customer_id", "") ?: ""
+        if (id.isEmpty()) {
+            id = java.util.UUID.randomUUID().toString()
+            p.edit().putString("customer_id", id).apply()
+        }
+        return id
+    }
+}
+
+private fun httpGet(url: String): String {
+    val conn = URL(url).openConnection() as HttpURLConnection
+    conn.connectTimeout = 10000
+    conn.readTimeout = 15000
+    try {
+        if (conn.responseCode != 200) throw Exception("HTTP " + conn.responseCode)
+        return conn.inputStream.bufferedReader().use { it.readText() }
+    } finally {
+        conn.disconnect()
+    }
+}
+
+private fun klipyUrl(file: JSONObject?, size: String): String =
+    file?.optJSONObject(size)?.optJSONObject("gif")?.optString("url").orEmpty()
+
+private fun giphyFetch(key: String, customerId: String, query: String): List<GiphyItem> {
+    val base = "https://api.klipy.com/api/v1/" + URLEncoder.encode(key, "UTF-8").replace("+", "%20") + "/gifs/"
+    val common = "page=1&per_page=24&customer_id=" + URLEncoder.encode(customerId, "UTF-8")
+    val url = if (query.isBlank()) {
+        base + "trending?" + common
+    } else {
+        base + "search?q=" + URLEncoder.encode(query, "UTF-8") + "&" + common
+    }
+    val root = JSONObject(httpGet(url))
+    val dataObj = root.optJSONObject("data")
+    val data = dataObj?.optJSONArray("data") ?: root.optJSONArray("data")
+        ?: return emptyList()
+    val out = ArrayList<GiphyItem>()
+    for (i in 0 until data.length()) {
+        val o = data.optJSONObject(i) ?: continue
+        val file = o.optJSONObject("file") ?: continue
+        val preview = klipyUrl(file, "sm").ifEmpty { klipyUrl(file, "md") }
+            .ifEmpty { klipyUrl(file, "xs") }
+        val gif = klipyUrl(file, "md").ifEmpty { klipyUrl(file, "hd") }
+            .ifEmpty { klipyUrl(file, "sm") }
+        if (preview.isNotEmpty() && gif.isNotEmpty()) {
+            val id = o.optString("slug", "").ifEmpty { o.optString("id", gif.hashCode().toString()) }
+            val dims = file.optJSONObject("md")?.optJSONObject("gif")
+                ?: file.optJSONObject("sm")?.optJSONObject("gif")
+            val w = dims?.optDouble("width", 0.0) ?: 0.0
+            val h = dims?.optDouble("height", 0.0) ?: 0.0
+            val ratio = if (w > 0.0 && h > 0.0) (w / h).toFloat().coerceIn(0.4f, 2.5f) else 1.0f
+            if (out.none { it.id == id }) out.add(GiphyItem(id, preview, gif, ratio))
+        }
+    }
+    return out
+}
+
+private fun downloadGif(context: Context, item: GiphyItem): File {
+    val file = File(context.cacheDir, "klipy_" + item.id + ".gif")
+    if (!file.exists() || file.length() == 0L) {
+        val conn = URL(item.gifUrl).openConnection() as HttpURLConnection
+        conn.connectTimeout = 10000
+        conn.readTimeout = 30000
+        try {
+            conn.inputStream.use { input -> file.outputStream().use { input.copyTo(it) } }
+        } finally {
+            conn.disconnect()
+        }
+    }
+    return file
+}
+
+/** Downloads a GIF and decodes it as an animated drawable (static on very old Android). */
+@Suppress("DEPRECATION")
+private fun loadDrawable(url: String): Drawable? {
+    val bytes = URL(url).openStream().use { it.readBytes() }
+    if (Build.VERSION.SDK_INT >= 28) {
+        return ImageDecoder.decodeDrawable(ImageDecoder.createSource(ByteBuffer.wrap(bytes)))
+    }
+    val bmp = BitmapFactory.decodeByteArray(bytes, 0, bytes.size) ?: return null
+    return BitmapDrawable(bmp)
+}
+
+@Composable
+private fun GiphyThumb(item: GiphyItem, onClick: () -> Unit) {
+    val drawable = produceState<Drawable?>(null, item.previewUrl) {
+        value = withContext(Dispatchers.IO) {
+            try {
+                loadDrawable(item.previewUrl)
+            } catch (e: Exception) {
+                null
+            }
+        }
+    }.value
+
+    Box(
+        modifier = Modifier
+            .fillMaxWidth()
+            .aspectRatio(item.ratio)
+            .clip(RoundedCornerShape(10.dp))
+            .background(MaterialTheme.colorScheme.surfaceContainer)
+            .clickable { onClick() }
+    ) {
+        if (drawable != null) {
+            AndroidView(
+                factory = { ctx ->
+                    ImageView(ctx).apply { scaleType = ImageView.ScaleType.CENTER_CROP }
+                },
+                modifier = Modifier.fillMaxSize(),
+                update = { iv ->
+                    iv.setImageDrawable(drawable)
+                    if (Build.VERSION.SDK_INT >= 28 && drawable is AnimatedImageDrawable) {
+                        drawable.repeatCount = AnimatedImageDrawable.REPEAT_INFINITE
+                        drawable.start()
+                    }
+                }
+            )
+        }
+    }
+}
