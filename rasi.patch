+/** Edit panel for a copied text item. */
+@Composable
+fun RasiEditPanel(text: MutableState<String>, onSave: () -> Unit, onCancel: () -> Unit) {
+    Column(Modifier.fillMaxWidth().padding(8.dp)) {
+        Surface(
+            color = LocalKeyboardScheme.current.surface,
+            border = BorderStroke(1.dp, SolidColor(LocalKeyboardScheme.current.outline)),
+            shape = RoundedCornerShape(8.dp),
+            modifier = Modifier.fillMaxWidth().height(120.dp),
+        ) {
+            Box(Modifier.padding(8.dp), contentAlignment = Alignment.TopStart) {
+                ActionTextEditor(
+                    text,
+                    multiline = true,
+                    autocorrect = true,
+                    placeholder = "Edit text"
+                )
+            }
+        }
+        Spacer(Modifier.height(6.dp))
+        Row {
+            Button(onClick = onSave, enabled = text.value.isNotEmpty()) { Text("Save") }
+            Spacer(Modifier.width(8.dp))
+            OutlinedButton(onClick = onCancel) { Text("Cancel") }
+        }
+    }
+}
