+import org.futo.inputmethod.latin.uix.actions.clipboard.CLIPBOARD_AUTHORITY
+import org.futo.inputmethod.latin.uix.actions.clipboard.ClipboardPasteRequest
+import org.futo.inputmethod.latin.uix.actions.clipboard.ClipboardProviderState
+import org.futo.inputmethod.latin.uix.actions.clipboard.clipboardDir
+import org.futo.inputmethod.latin.uix.theme.Typography
+import java.io.File
+
+/** "Screenshot" chip shown in the suggestion bar after taking a screenshot, like a copied-text chip. */
+@Composable
+fun RowScope.RasiScreenshotChip() {
+    val shot = RasiState.screenshot.value ?: return
+    val manager = LocalManager.current
+    val context = LocalContext.current
+    val view = LocalView.current
+
+    val thumb by produceState<ImageBitmap?>(null, shot.file) {
+        value = withContext(Dispatchers.IO) {
+            try {
+                val f = File(context.clipboardDir, shot.file)
+                val bounds = BitmapFactory.Options().apply { inJustDecodeBounds = true }
+                BitmapFactory.decodeFile(f.path, bounds)
+                var sample = 1
+                while (bounds.outWidth / (sample * 2) >= 160 && bounds.outHeight / (sample * 2) >= 160) sample *= 2
+                val opts = BitmapFactory.Options().apply { inSampleSize = sample }
+                BitmapFactory.decodeFile(f.path, opts)?.asImageBitmap()
+            } catch (e: Throwable) {
+                null
+            }
+        }
+    }
+
+    Row(
+        Modifier.weight(1.0f).fillMaxHeight(),
+        horizontalArrangement = Arrangement.Center,
+        verticalAlignment = Alignment.CenterVertically
+    ) {
+        Box(Modifier.fillMaxHeight().clickable {
+            manager.performHapticAndAudioFeedback(Constants.CODE_TAB, view)
+            val request = ClipboardProviderState.addRequest(
+                ClipboardPasteRequest(
+                    file = File(context.clipboardDir, shot.file),
+                    mimeType = shot.mime,
+                    expiration = System.currentTimeMillis() + 5L * 60L * 1000L
+                )
+            )
+            val uri = "content://${CLIPBOARD_AUTHORITY}/clip/$request".toUri()
+            manager.typeUri(uri, listOf(shot.mime), true)
+            RasiState.screenshot.value = null
+        }.padding(4.dp)) {
+            Surface(
+                color = LocalKeyboardScheme.current.keyboardContainer,
+                shape = RoundedCornerShape(8.dp)
+            ) {
+                CompositionLocalProvider(LocalContentColor provides LocalKeyboardScheme.current.onKeyboardContainer) {
+                    Row(
+                        horizontalArrangement = Arrangement.spacedBy(4.dp),
+                        verticalAlignment = Alignment.CenterVertically,
+                        modifier = Modifier.padding(horizontal = 8.dp, vertical = 4.dp).fillMaxHeight()
+                    ) {
+                        val b = thumb
+                        if (b != null) {
+                            Image(
+                                bitmap = b,
+                                contentDescription = null,
+                                contentScale = ContentScale.Crop,
+                                modifier = Modifier
+                                    .height(30.dp)
+                                    .aspectRatio(b.width.toFloat() / b.height.toFloat())
+                                    .clip(RoundedCornerShape(4.dp))
+                            )
+                        } else {
+                            Icon(painterResource(R.drawable.image), contentDescription = null)
+                        }
+                        Text("Screenshot", style = Typography.Small)
+                    }
+                }
+            }
+        }
+    }
+}
